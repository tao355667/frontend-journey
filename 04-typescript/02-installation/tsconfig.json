{
  "compilerOptions": {
    /* 基本选项 */
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",

    /* 严格类型检查选项 */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,

    /* 模块解析选项 */
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,

    /* 源代码映射 */
    "sourceMap": true,
    "declaration": true,

    /* 其他选项 */
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },

  /* 包含的文件 */
  "include": ["src/**/*"],

  /* 排除的文件 */
  "exclude": ["node_modules", "dist"]
}
